                "to": [
                    "{{1.email}}"
                ],
                "from": "\"Alison Malka\" <malka@chalombayitlelab.com>",
                "subject": "{{1.subject}}",
                "bodyType": "rawHtml",
                "content": "{{1.html}}"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "cc": {
                            "mode": "chose"
