{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-sequence",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron-digest",
      "schedule": "0 19 * * *"
    }
  ]
}